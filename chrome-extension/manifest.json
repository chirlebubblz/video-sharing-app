{
  "manifest_version": 3,
  "name": "Not Another Video Sharing App",
  "version": "1.0",
  "description": "Record your screen and face easily, and save your videos to Google Drive.",
  "permissions": [
    "desktopCapture",
    "activeTab",
    "scripting",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.svg",
      "48": "icon.svg",
      "128": "icon.svg"
    }
  },
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["driveStorage.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["permission.html", "permission.js", "icon.svg", "driveStorage.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
